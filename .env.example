# ─── Public base URL ────────────────────────────────────────────────────────
# The deployed origin, no trailing slash. Must match exactly what is registered
# as the OAuth redirect in Meta's console, because Meta compares strings.
APP_URL=https://distributionoss.vercel.app

# ─── Instagram (Meta app) ───────────────────────────────────────────────────
# developers.facebook.com → your app → Instagram → API setup with Instagram login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ─── Token encryption ───────────────────────────────────────────────────────
# 32 random bytes, base64. Account tokens are encrypted with this before they
# touch the database and are never sent to the browser.
#   openssl rand -base64 32
TOKEN_ENC_KEY=

# ─── Postgres (Neon) ────────────────────────────────────────────────────────
DATABASE_URL=

# ─── Cloudflare R2 ──────────────────────────────────────────────────────────
# The bucket is private. Uploads use a presigned PUT, publishing uses a
# presigned GET that expires — no public bucket, no r2.dev domain.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=distribution-os-media

# ─── Scheduler ──────────────────────────────────────────────────────────────
# Shared secret the cron trigger presents to /api/publish. Any long random string.
CRON_SECRET=
