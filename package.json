{
  "name": "distribution-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Distribution OS — local-first content & distribution command center",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "worker:dev": "wrangler dev",
    "db:apply": "wrangler d1 execute distribution-os --file=db/schema.sql --remote",
    "db:apply:local": "wrangler d1 execute distribution-os --file=db/schema.sql --local"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@cloudflare/workers-types": "^5.20260730.1",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  }
}
